# ---------------------------------------------------------------------------
# Azure AI Foundry inference (agent + embeddings + offline eval judge)
# ---------------------------------------------------------------------------

# Your Azure AI Foundry project endpoint. Find it in the Foundry portal under
# your project's Overview. Inference runs directly against this endpoint.
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"

# Auth: set a key to use API-key auth. Leave it empty to use Microsoft Entra ID
# (DefaultAzureCredential: managed identity, `az login`, or environment creds).
AZURE_AI_API_KEY=""

# Foundry deployment names. These are the deployment names in your Foundry
# project, not the base model names.
CONCIERGE_MODEL="gpt-4o-mini"
CONCIERGE_EMBEDDING_MODEL="text-embedding-3-small"

# Offline eval judge deployment (evals/evaluators.py). Defaults to gpt-4o.
EVAL_JUDGE_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# LangSmith tracing and platform (not an LLM credential)
# ---------------------------------------------------------------------------

LANGSMITH_PROJECT="banking-concierge"
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_WORKSPACE_ID=""

# Only needed for scripts/load_generation.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""

# Optional, for scripts/setup_workspace.py. Deployments and dashboards can't be
# listed from the public v1 API, so paste the uuid from the resource's URL in
# the LangSmith UI to tag it into the Application; leave blank to tag by hand.
APPLICATION_DEPLOYMENT_ID=""
APPLICATION_DASHBOARD_ID=""
