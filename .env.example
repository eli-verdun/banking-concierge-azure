# ---------------------------------------------------------------------------
# OpenAI-compatible gateway (agent + offline eval judge)
# ---------------------------------------------------------------------------

# Complete route prefix: the SDK appends /chat/completions.
GATEWAY_BASE_URL="https://<gateway-host>/<route-prefix>"
GATEWAY_MODEL="gpt-4o-mini"

# Entra client-credentials auth. Tokens are cached and automatically refreshed.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_SCOPE="<resource>/.default"

# Optional gateway key, e.g. Ocp-Apim-Subscription-Key. Do not use Authorization;
# that header carries the Entra bearer token.
GATEWAY_KEY_HEADER=""
GATEWAY_KEY=""

# Optional: only for gateway routes requiring ?api-version=...
GATEWAY_API_VERSION=""

# Offline judge model/deployment name expected by the gateway.
EVAL_JUDGE_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# Direct Azure AI Foundry inference (retrieval embeddings only)
# ---------------------------------------------------------------------------

AZURE_AI_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"

# Set a key for API-key auth, or leave empty for DefaultAzureCredential
# (managed identity, `az login`, or environment credentials).
AZURE_AI_API_KEY=""
CONCIERGE_EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------------------
# LangSmith tracing and platform (not an LLM credential)
# ---------------------------------------------------------------------------

LANGSMITH_PROJECT="banking-concierge"
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_WORKSPACE_ID=""

# Only needed for scripts/load_generation.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""

# Optional, for scripts/setup_workspace.py. Deployments and dashboards can't be
# listed from the public v1 API, so paste the uuid from the resource's URL in
# the LangSmith UI to tag it into the Application; leave blank to tag by hand.
APPLICATION_DEPLOYMENT_ID=""
APPLICATION_DASHBOARD_ID=""
